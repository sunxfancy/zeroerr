set(my_include_folder "${CMAKE_CURRENT_LIST_DIR}/../include/zeroerr")
set(my_extension_folder "${CMAKE_CURRENT_LIST_DIR}/../extension/zeroerr")
set(my_src_folder "${CMAKE_CURRENT_LIST_DIR}/../src")

function(loadfile)
    file(READ ${ARGV0} CONTENTS)
    string(REGEX REPLACE "#include [\"<]zeroerr[^\n]*" "" STRIPPED "${CONTENTS}")
    set(${ARGV1} "${STRIPPED}" PARENT_SCOPE)
endfunction()


set(core_headers
    internal/config.h string.h buffer.h color.h internal/console.h
    internal/debugbreak.h internal/threadsafe.h internal/time.h internal/fuzz_signal.h internal/typetraits.h
    internal/text.h print.h internal/decomposition.h format.h dbg.h assert.h log.h unittest.h)
set(fuzz_headers internal/rng.h internal/serialization.h domains/domain.h domains/in_range.h
    domains/element_of.h domains/container_of.h domains/aggregate_of.h domains/arbitrary.h fuzztest.h)
file(WRITE zeroerr.hpp "// Generated by scripts/gen-single-file.cmake. Do not edit.\n#pragma once\n")
foreach(header IN LISTS core_headers)
    loadfile(${my_include_folder}/${header} part)
    file(APPEND zeroerr.hpp "${part}\n")
endforeach()
file(APPEND zeroerr.hpp "#if defined(ZEROERR_ENABLE_FUZZTEST)\n")
foreach(header IN LISTS fuzz_headers)
    loadfile(${my_include_folder}/${header} part)
    file(APPEND zeroerr.hpp "${part}\n")
endforeach()
file(APPEND zeroerr.hpp "#endif\n")
foreach(feature BENCHMARK TABLE STD_ADAPTER)
    if(feature STREQUAL "BENCHMARK")
        set(header benchmark.h)
    elseif(feature STREQUAL "TABLE")
        set(header table.h)
    else()
        set(header std_adapter.h)
    endif()
    loadfile(${my_include_folder}/${header} part)
    if(feature STREQUAL "TABLE")
        file(APPEND zeroerr.hpp "#if defined(ZEROERR_ENABLE_TABLE) || (defined(ZEROERR_IMPLEMENTATION) && defined(ZEROERR_ENABLE_BENCHMARK))\n${part}\n#endif\n")
    else()
        file(APPEND zeroerr.hpp "#if defined(ZEROERR_ENABLE_${feature})\n${part}\n#endif\n")
    endif()
endforeach()
file(APPEND zeroerr.hpp "#ifdef ZEROERR_IMPLEMENTATION\n")
foreach(source string.cpp buffer.cpp threadsafe.cpp color.cpp print.cpp text.cpp assert_text.cpp
               console.cpp log.cpp unittest.cpp)
    loadfile(${my_src_folder}/${source} part)
    file(APPEND zeroerr.hpp "${part}\n")
endforeach()
file(APPEND zeroerr.hpp "#ifdef ZEROERR_ENABLE_FUZZTEST\n")
foreach(source rng.cpp fuzztest.cpp serialization.cpp)
    loadfile(${my_src_folder}/${source} part)
    file(APPEND zeroerr.hpp "${part}\n")
endforeach()
file(APPEND zeroerr.hpp "#endif\n")
file(APPEND zeroerr.hpp "#if defined(ZEROERR_ENABLE_TABLE) || defined(ZEROERR_ENABLE_BENCHMARK)\n")
loadfile(${my_src_folder}/table.cpp part)
file(APPEND zeroerr.hpp "${part}\n#endif\n")
file(APPEND zeroerr.hpp "#ifdef ZEROERR_ENABLE_BENCHMARK\n")
loadfile(${my_src_folder}/benchmark.cpp part)
file(APPEND zeroerr.hpp "${part}\n#endif\n")
file(APPEND zeroerr.hpp "#endif // ZEROERR_IMPLEMENTATION\n")

# Keep generated code free of trailing whitespace from input comments.
file(READ zeroerr.hpp generated)
string(REGEX REPLACE "[ \t]+\n" "\n" generated "${generated}")
file(WRITE zeroerr.hpp "${generated}")
